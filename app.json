{
  "expo": {
    "name": "Edu Focus",
    "slug": "edu_focus",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "edufocus",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "by.edufocus.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "by.edufocus.app"
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Приложение сохраняет фото домашнего задания к парам.",
          "cameraPermission": "Приложение снимает фото домашнего задания.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#1B6B4A"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-widgets",
        {
          "enableAndroid": true,
          "widgets": [
            {
              "name": "ScheduleWidget",
              "displayName": "Пары",
              "description": "Текущая пара и занятия на завтра",
              "ios": {
                "supportedFamilies": ["systemMedium"],
                "initialLayout": "./src/widgets/ScheduleWidget.tsx"
              },
              "android": {
                "targetCellWidth": 4,
                "targetCellHeight": 3,
                "resizeMode": "both",
                "initialLayout": "./src/widgets/ScheduleWidget.android.tsx"
              }
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
